# Your account token. Treat it like a password: it is the whole account.
DISCORD_TOKEN=
# TOTP secret, only if the account has 2FA.
DISCORD_TOTP_KEY=

# Rakazo routine webhook (the bot's Webhook trigger). Without these, nothing wakes.
RAKAZO_WEBHOOK_URL=
RAKAZO_WEBHOOK_SECRET=
# Optional extra headers for a proxy in front of Rakazo, as JSON.
# RAKAZO_EXTRA_HEADERS={"x-proxy-key":"..."}
# RAKAZO_TIMEOUT_MS=15000

# What wakes a routine.
DISCORD_TRIGGER_DMS=true
DISCORD_TRIGGER_MESSAGE_REQUESTS=false
DISCORD_TRIGGER_MENTIONS=true
DISCORD_TRIGGER_CHANNELS=
DISCORD_TRIGGER_KEYWORDS=
DISCORD_TRIGGER_FROM=
DISCORD_TRIGGER_IGNORE=
DISCORD_TRIGGER_IGNORE_BOTS=true
DISCORD_TRIGGER_IGNORE_SELF=true
# DISCORD_RULES_FILE=./rules.json

# Sending is off until you enable it. off | allowlist | all
DISCORD_SEND_MODE=off
DISCORD_SEND_ALLOWLIST=
DISCORD_SEND_DM_ONLY=false

# MCP server. Rakazo needs a public HTTPS URL, so tunnel this port.
DISCORD_MCP_PORT=8787
DISCORD_MCP_HOST=127.0.0.1
DISCORD_MCP_PATH=/mcp
# Generated and printed when unset. Set it to keep the token stable.
DISCORD_MCP_TOKEN=

# Debugging.
DISCORD_LOG_FILE=
DISCORD_VERBOSE=false
